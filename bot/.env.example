# Скопируйте этот файл в переменные окружения вашего облачного хостинга
# (Railway/Render/VPS) — САМИ, через их панель управления. Этот агент не
# создаёт облачные аккаунты и не вводит реальные ключи за вас.

# Токен Telegram-бота — получите у @BotFather в Telegram (команда /newbot)
TELEGRAM_BOT_TOKEN=

# Ваш числовой Telegram user id (не username!) — узнать у @userinfobot.
# Можно указать несколько через запятую — это белый список: бот будет
# отвечать ТОЛЬКО этим людям, остальным — молчать. Обязательно к заполнению,
# иначе бот с доступом к Gmail и коммерческим данным будет открыт всем.
ALLOWED_TELEGRAM_USER_IDS=

# Ключ Anthropic API — console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Gmail API OAuth (см. bot/gmail_oauth_setup.py — одноразовый скрипт,
# который вы запускаете на своём компьютере САМИ, чтобы получить refresh
# token, не передавая боту ваш пароль от Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# Путь к постоянному диску (volume) на хостинге, где будут жить
# buyers.xlsx, kp_state.json, вложения — ДОЛЖЕН сохраняться между
# перезапусками контейнера, иначе вся бизнес-история теряется при редеплое.
DATA_DIR=/data
